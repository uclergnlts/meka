# Bu dosyayı .env adıyla kopyalayın ya da aynı değerleri hosting panelindeki
# Node.js uygulamasının "Environment variables" bölümüne girin.
NODE_ENV=production
# Parolada özel karakter varsa URL biçiminde yazılmalıdır (ör. @ yerine %40).
DATABASE_URL=mysql://VERITABANI_KULLANICISI:PAROLA@localhost:3306/VERITABANI_ADI
# Uygulama hosting'in web sunucusunun arkasında çalışır.
TRUST_PROXY=1
